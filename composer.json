{
  "name": "bromate/remote-media-bridge",
  "description": "Bromate Remote Media Bridge",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
      {
        "name": "bromate",
        "email": "cedric@moriskelly.com"
      }
  ],
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org"
    }
  ],
  "require": {
    "php": ">=7.4"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "7.4.33"
    },
    "sort-packages": true
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.2"
  },
  "scripts": {
      "lint": "phpcs ./ --standard=WordPress --extensions=php",
      "lint:file": "phpcs --standard=WordPress --extensions=php",
      "fix": "phpcbf --standard=WordPress --extensions=php ./",
      "fix:file": "phpcbf --standard=WordPress --extensions=php",
      "zip": "rm -f bromate-remote-media-bridge.zip && zip -r bromate-remote-media-bridge.zip . -x '*.git*' -x 'vendor/*' -x 'composer.json' -x 'composer.lock' -x '*.md'"
  }
  
}
