{
  "name": "afg/botoxs-legacy",
  "description": "Very Lazy Sync Images.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
      {
        "name": "Cédric Moris Kelly",
        "email": "cedric@moriskelly.com"
      }
  ],
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org"
    }
  ],
  "require": {
    "php": ">=7.4"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "7.4.33"
    },
    "sort-packages": true
  },
  "require-dev": {
    "brain/monkey": "^2.6",
    "phpunit/phpunit": "^9.6",
    "qossmic/deptrac": "^0.24",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.2"
  },
  "scripts": {
    "build": [
      "@composer --no-plugins --no-interaction install --no-scripts --no-dev"
    ],
    "lint": "phpcs inc/",
    "fix": "phpcbf --standard=Wordpress --extensions=php inc/",
    "graph:php": "php vendor/qossmic/deptrac/deptrac.php analyse --config-file=deptrac.yaml",
    "graph:php:dot": "php vendor/qossmic/deptrac/deptrac.php analyse --config-file=deptrac.yaml --formatter=graphviz-dot --output=.github/graphs/php-dependencies.dot"
  },
  "scripts-descriptions": {
    "build": "Build project artifact."
  }
  
}
